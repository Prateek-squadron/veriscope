# Production Environment Variables
# Replace these values with your actual production values

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (replace <password> with your actual password)
MONGODB_URI=mongodb+srv://veriscope-user:<password>@veriscope-cluster.xxxxx.mongodb.net/veriscope?retryWrites=true&w=majority

# JWT Secret (generate a strong secret: https://www.allkeysgenerator.com/Random/Security-Encryption-Key-Generator.aspx)
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-this

# Frontend URL (will be your Vercel URL)
CLIENT_URL=https://your-app-name.vercel.app