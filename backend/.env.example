# VeriScope Backend Environment Variables
# Copy this file to .env and fill in your actual values

# MongoDB Connection
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/veriscope

# JWT Authentication
JWT_SECRET=your-super-secure-jwt-secret-key
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# AI Services API Keys (for phishing/malware detection)

# VirusTotal API (Free tier: 1000 requests/day, 4 requests/minute)
# Get your free API key at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# Hugging Face Inference API (Free tier: 30,000 input characters/month)  
# Get your free API key at: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=your-huggingface-api-key-here

# Optional: Rate limiting and fallback settings
MAX_SCAN_REQUESTS_PER_HOUR=50
ENABLE_API_FALLBACKS=true